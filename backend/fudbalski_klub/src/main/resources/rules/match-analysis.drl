rule "11. Sterilna dominacija bez penetracije (Domaći)"
    salience 85
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId), $expPass: expectedHomePassRate, $expShots: expectedHomeShots)
    $stats: TeamStatisticGraph(homePassSuccessRate >= $expPass, homeShots <= ($expShots * 0.4))
then
    $fact.setAnalysisText("Kružite loptom besciljno. Imate odličan procenat dodavanja (" + $stats.getHomePassSuccessRate() + "%), ali drastično manje šuteva (" + $stats.getHomeShots() + ") od očekivanog proseka (" + String.format("%.1f", $expShots) + ").");
    $fact.setRecommendationText("Ubrzajte protok lopte u završnoj trećini. Uvedite krilnog igrača koji može da probije blok '1 na 1' umesto pasova unazad.");
    $fact.setSeverity("MEDIUM");
    System.out.println(">>> [DROOLS] Okinuto: Sterilna igra (Domaći)");
end

