package rules;

import com.football_club.MatchTracking.model.graph.TeamStatisticGraph;
import com.football_club.MatchTracking.model.graph.GameGraph;
import com.football_club.MatchTracking.model.graph.ClubGraph;
import com.football_club.MatchTracking.model.graph.AppearanceGraph;
import com.football_club.MatchTracking.dto.TacticalAnalysisDTO;



rule "1. Hitna izmena - Rizik od crvenog kartona (Domaći)"
    salience 110
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $app: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", yellowCards > 0, fouls >= 3, passingAccuracy < 65.0)
then
    $fact.setAnalysisText("Igrač u prvoj postavi je pod velikim rizikom od isključenja. Već ima žuti karton, napravio je " + $app.getFouls() + " faulova, a tačnost pasova mu je pala na " + $app.getPassingAccuracy() + "%.");
    $fact.setRecommendationText("Hitna izmena! Izvedite ovog igrača iz igre kako biste izbegli crveni karton i sačuvali brojčanu ravnopravnost.");
    $fact.setSeverity("CRITICAL");
    System.out.println(">>> [DROOLS] Okinuto: Rizik od crvenog kartona (Domaći)");
end

rule "2. Hitna izmena - Rizik od crvenog kartona (Gosti)"
    salience 110
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(awayClub != null, awayClub.id != null, awayClub.id.equals($mojId))
    $app: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", yellowCards > 0, fouls >= 3, passingAccuracy < 65.0)
then
    $fact.setAnalysisText("Igrač u prvoj postavi je pod velikim rizikom od isključenja. Već ima žuti karton, napravio je " + $app.getFouls() + " faulova, a tačnost pasova mu je pala na " + $app.getPassingAccuracy() + "%.");
