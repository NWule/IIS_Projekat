rule "8. Katastrofalna predaja lopte - Domaci"
    salience 50
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(homePassSuccessRate > 0 && homePassSuccessRate < 65.0)
then
    $fact.setAnalysisText("Tačnost pasova je kritično niska (" + $stats.getHomePassSuccessRate() + "%). Tim konstantno gubi loptu u tranziciji.");
    $fact.setRecommendationText("Smanjiti rizična dodavanja i duge lopte. Pojednostaviti igru sa maksimalno dva dodira po igraču.");
    $fact.setSeverity("HIGH");
    System.out.println(">>> [DROOLS] Okinuto: Loš pas (Domaci)");
end

