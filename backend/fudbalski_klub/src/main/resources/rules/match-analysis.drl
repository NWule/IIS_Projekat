rule "11. Dominacija bez penetracije (Domaći)"
    salience 85
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(homePossession > 65.0, homeShots <= 3)
then
    $fact.setAnalysisText("Imate potpunu kontrolu lopte (" + $stats.getHomePossession() + "%), ali je realizacija očajna (Samo " + $stats.getHomeShots() + " šuta). Posed je sterilan.");
    $fact.setRecommendationText("Ubrzajte protok lopte u završnoj trećini. Uvedite krilnog igrača koji može da probije blok '1 na 1' umesto da kružite oko kaznenog prostora.");
    $fact.setSeverity("MEDIUM");
    System.out.println(">>> [DROOLS] Okinuto: Sterilan posed (Domaći)");
end

