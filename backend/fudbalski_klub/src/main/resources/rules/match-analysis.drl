rule "9. Potpuni gubitak kontrole lopte (Domaći)"
    salience 90
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId), $expPass: expectedHomePassRate)
    $stats: TeamStatisticGraph(homePassSuccessRate > 0, homePassSuccessRate < ($expPass - 15.0), homePassSuccessRate < 70.0)
then
    $fact.setAnalysisText("Ekipa ne uspeva da poveže dodavanja. Preciznost je pala na kritičnih " + $stats.getHomePassSuccessRate() + "% (Očekivano: " + String.format("%.1f", $expPass) + "%). Tim je pod stalnim pritiskom.");
    $fact.setRecommendationText("Prestanite sa dugim loptama ukoliko to nije svesna taktika. Približite srednji red odbrani i igrajte sigurnije pasove u noge.");
    $fact.setSeverity("HIGH");
    System.out.println(">>> [DROOLS] Okinuto: Gubitak kontrole (Domaći)");
end

