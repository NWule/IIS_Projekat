rule "5. Sistemska nervoza - Više igrača sa kartonima (Domaći)"
    salience 99
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $yellowCount: Number(intValue >= 3) from accumulate (
        $a: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", yellowCards > 0),
        count($a)
    )
then
    $fact.setAnalysisText("Čak " + $yellowCount + " igrača prve postave ima žuti karton. Ekipa je pod velikom tenzijom i gubi kontrolu nad duelima.");
    $fact.setRecommendationText("Naložite timu da obori tempo igre. Izbegavajte agresivan presing i insistirajte na markaciji prostora dok se ekipa ne smiri.");
    $fact.setSeverity("HIGH");
    System.out.println(">>> [DROOLS] Okinuto: Sistemska nervoza (Domaći)");
end

