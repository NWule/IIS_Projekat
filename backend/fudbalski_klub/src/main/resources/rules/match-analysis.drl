rule "13. Alibi šutevi sa distance (Domaći)"
    salience 80
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId), $expShots: expectedHomeShots, $expTarget: expectedHomeShotsOnTarget)
    $stats: TeamStatisticGraph(homeShots > $expShots, homeShotsOnTarget < ($expTarget * 0.6))
then
    $fact.setAnalysisText("Ekipa previše forsira neizrađene šuteve. Imate natprosečan broj udaraca (" + $stats.getHomeShots() + "), ali premalo u okvir gola (" + $stats.getHomeShotsOnTarget() + ").");
    $fact.setRecommendationText("Zahtevajte od veznog reda da ne šutira ishitreno sa distance. Lopta mora da uđe dublje u šesnaesterac kroz kombinatoriku.");
    $fact.setSeverity("MEDIUM");
    System.out.println(">>> [DROOLS] Okinuto: Loša selekcija šuta (Domaći)");
end

