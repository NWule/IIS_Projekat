rule "7. Potpuno bezopasan napad - Domaci"
    salience 60
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(homeShots <= 3)
then
    $fact.setAnalysisText("Napad je potpuno bezopasan. Tim je uputio svega " + $stats.getHomeShots() + " šuta ka golu tokom meča.");
    $fact.setRecommendationText("Formacija je previše defanzivna. Bekovi moraju aktivnije da se ponavljaju u napadu, a vezni red mora da rizikuje sa pasovima unapred.");
    $fact.setSeverity("HIGH");
    System.out.println(">>> [DROOLS] Okinuto: Slab napad (Domaci)");
end

