rule "9. Potpuni gubitak poseda (Domaći)"
    salience 90
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(homePossession > 0 && homePossession < 35.0)
then
    $fact.setAnalysisText("Ekipa je potpuno prepustila loptu protivniku (Posed: " + $stats.getHomePossession() + "%). Tim je pod konstantnim pritiskom.");
    $fact.setRecommendationText("Ako ovo nije svesna taktika (bunker), morate podići poslednju liniju odbrane za 10 metara i započeti viši presing kako biste povratili kontrolu.");
    $fact.setSeverity("HIGH");
    System.out.println(">>> [DROOLS] Okinuto: Gubitak poseda (Domaći)");
end

