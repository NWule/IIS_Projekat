rule "9. Loša selekcija šuteva - Domaci"
    salience 30
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(homeShots > 12 && homeShotsOnTarget <= 2)
then
    $fact.setAnalysisText("Ispaljeno je dosta šuteva (" + $stats.getHomeShots() + "), ali je jako malo išlo u okvir gola. Šutira se iz nepovoljnih pozicija.");
    $fact.setRecommendationText("Strpljivije graditi napad. Tražiti bolja rešenja i pasove u završnoj trećini umesto ishitrenih šuteva sa distance.");
    $fact.setSeverity("LOW");
    System.out.println(">>> [DROOLS] Okinuto: Loši šutevi (Domaci)");
end

