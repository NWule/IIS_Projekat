then
    $fact.setAnalysisText("Ekipa previše forsira neizrađene šuteve (Ukupno: " + $stats.getHomeShots() + ", U okvir: " + $stats.getHomeShotsOnTarget() + "). Napadi se prerano završavaju.");
    $fact.setRecommendationText("Zahtevajte od veznog reda da ne šutira ishitreno sa distance. Lopta mora da uđe u šesnaesterac kroz kombinatoriku.");
    $fact.setSeverity("MEDIUM");
