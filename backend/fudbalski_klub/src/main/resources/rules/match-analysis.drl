rule "10. Loš tajming utrčavanja (Ofsajdi) - Domaci"
    salience 10
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(homeOffsides > 5)
then
    $fact.setAnalysisText("Napadači su prečesto u ofsajdu (" + $stats.getHomeOffsides() + "), što prekida napadački momentum.");
    $fact.setRecommendationText("Korigovati tajming upućivanja duge lopte. Napadači moraju da uspore utrčavanje ili da menjaju smer kretanja po širini.");
    $fact.setSeverity("LOW");
    System.out.println(">>> [DROOLS] Okinuto: Ofsajdi (Domaci)");
end

