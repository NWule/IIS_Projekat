    $fact.setSeverity("CRITICAL");
    System.out.println(">>> [DROOLS] Okinuto: Rizik od crvenog kartona (Gosti)");
end

rule "3. Katastrofalan pad forme ključnog igrača (Domaći)"
    salience 105
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $app: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", minutesPlayed > 45, passingAccuracy < 45.0, rating < 5.5)
then
    $fact.setAnalysisText("Igrač iz prve postave beleži kritično loše parametre. Tačnost pasova mu je samo " + $app.getPassingAccuracy() + "%, a uticaj na igru je minimalan.");
    $fact.setRecommendationText("Reagujte izmenom odmah. Igrač je verovatno iscrpljen ili taktički potpuno zatvoren od strane protivnika.");
    $fact.setSeverity("CRITICAL");
    System.out.println(">>> [DROOLS] Okinuto: Pad forme igrača (Domaći)");
end

