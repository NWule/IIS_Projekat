rule "17. Ekstremni pritisak protivnika (Domaći pod opsadom)"
    salience 70
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId), $oppExpShots: expectedAwayShots)
    $stats: TeamStatisticGraph(awayShots > ($oppExpShots * 1.5), awayShots > 10)
then
    $fact.setAnalysisText("Vaš tim trpi nezapamćen pritisak. Protivnik je već uputio " + $stats.getAwayShots() + " šuteva ka golu (Znato više od njihovog proseka). Odbrana je pred pucanjem.");
    $fact.setRecommendationText("Pređite u formaciju sa 5 odbrambenih igrača (npr. 5-3-2) kako biste zatvorili centralne koridore i izdržali pritisak.");
    $fact.setSeverity("CRITICAL");
    System.out.println(">>> [DROOLS] Okinuto: Pod opsadom (Domaći)");
end

