package rules;

import com.football_club.MatchTracking.model.graph.TeamStatisticGraph;
import com.football_club.MatchTracking.model.graph.GameGraph;
import com.football_club.MatchTracking.model.graph.ClubGraph;
import com.football_club.MatchTracking.dto.TacticalAnalysisDTO;

rule "3. Previse napravljenih faulova - Domaci"
    salience 85
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(homeFouls > 18)
then
    $fact.setAnalysisText("Napravljeno je previše prekršaja (" + $stats.getHomeFouls() + "), što protivniku daje česte prekide i secka ritam igre.");
    $fact.setRecommendationText("Smanjiti agresivnost u duelima 1 na 1. Fokusirati se na pozicioniranje i zonsku odbranu.");
    $fact.setSeverity("MEDIUM");
    System.out.println(">>> [DROOLS] Okinuto: Faulovi (Domaci)");
end

rule "3. Previse napravljenih faulova - Gosti"
    salience 85
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(awayClub != null, awayClub.id != null, awayClub.id.equals($mojId))
    $stats: TeamStatisticGraph(awayFouls > 18)
then
    $fact.setAnalysisText("Napravljeno je previše prekršaja (" + $stats.getAwayFouls() + "), što protivniku daje česte prekide i secka ritam igre.");
    $fact.setRecommendationText("Smanjiti agresivnost u duelima 1 na 1. Fokusirati se na pozicioniranje i zonsku odbranu.");
    $fact.setSeverity("MEDIUM");
    System.out.println(">>> [DROOLS] Okinuto: Faulovi (Gosti)");
end

rule "4. Propustljiva odbrana i pritisak - Domaci"
    salience 80
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(awayShots > 15)
then
    $fact.setAnalysisText("Odbrana dopušta preveliki broj šuteva protivnika (" + $stats.getAwayShots() + "). Vezni red ne štiti poslednju liniju.");
    $fact.setRecommendationText("Zgusnuti sredinu terena, povući defanzivnog veznog bliže štoperima i smanjiti prostor između linija.");
    $fact.setSeverity("HIGH");
    System.out.println(">>> [DROOLS] Okinuto: Odbrana (Domaci)");
end

