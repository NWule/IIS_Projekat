    $fact.setRecommendationText("Ekipa je prepasivna. Naložite veznom redu da uđe oštrije u duel i podigne nivo energije (tzv. taktički faul) kako bi se presekao ritam protivnika.");
    $fact.setSeverity("MEDIUM");
    System.out.println(">>> [DROOLS] Okinuto: Pasivnost (Domaći)");
end

