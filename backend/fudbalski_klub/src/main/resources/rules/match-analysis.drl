    $fact.setRecommendationText("Promenite pristup napadu. Umesto dugih lopti iza leđa odbrane, napadači treba da se otvaraju između linija i traže loptu u noge.");
    $fact.setSeverity("LOW");
    System.out.println(">>> [DROOLS] Okinuto: Ofsajdi (Domaći)");
end

