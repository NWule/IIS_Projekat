package rules;

import com.football_club.MatchTracking.model.graph.TeamStatisticGraph;
import com.football_club.MatchTracking.model.graph.GameGraph;
import com.football_club.MatchTracking.model.graph.ClubGraph;
import com.football_club.MatchTracking.model.graph.AppearanceGraph;
import com.football_club.MatchTracking.dto.TacticalAnalysisDTO;

rule "1. Hitna izmena - Rizik od crvenog kartona (Domaći)"
    salience 110
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId), $expPass: expectedHomePassRate)
    $app: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", yellowCards > 0, fouls >= 3, passingAccuracy < ($expPass - 10.0))
then
    $fact.setAnalysisText("Igrač u prvoj postavi je pod velikim rizikom od isključenja. Već ima žuti karton, napravio je " + $app.getFouls() + " faulova, a tačnost pasova mu je pala na " + $app.getPassingAccuracy() + "% usled nervoze.");
    $fact.setRecommendationText("Hitna izmena! Izvedite ovog igrača iz igre kako biste izbegli crveni karton i sačuvali brojčanu ravnopravnost.");
    $fact.setSeverity("CRITICAL");
    System.out.println(">>> [DROOLS] Okinuto: Rizik od crvenog kartona (Domaći)");
end

rule "2. Hitna izmena - Rizik od crvenog kartona (Gosti)"
    salience 110
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(awayClub != null, awayClub.id != null, awayClub.id.equals($mojId), $expPass: expectedAwayPassRate)
    $app: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", yellowCards > 0, fouls >= 3, passingAccuracy < ($expPass - 10.0))
then
    $fact.setAnalysisText("Igrač u prvoj postavi je pod velikim rizikom od isključenja. Već ima žuti karton, napravio je " + $app.getFouls() + " faulova, a tačnost pasova mu je pala na " + $app.getPassingAccuracy() + "% usled nervoze.");
    $fact.setRecommendationText("Hitna izmena! Izvedite ovog igrača iz igre kako biste izbegli crveni karton i sačuvali brojčanu ravnopravnost.");
    $fact.setSeverity("CRITICAL");
    System.out.println(">>> [DROOLS] Okinuto: Rizik od crvenog kartona (Gosti)");
end

rule "3. Katastrofalan pad forme ključnog igrača (Domaći)"
    salience 105
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId), $expPass: expectedHomePassRate)
    $app: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", minutesPlayed > 45, passingAccuracy < ($expPass - 25.0), rating < 5.5)
then
    $fact.setAnalysisText("Igrač iz prve postave beleži kritično loše parametre. Tačnost pasova mu je drastično ispod timskog očekivanja (samo " + $app.getPassingAccuracy() + "%).");
    $fact.setRecommendationText("Reagujte izmenom odmah. Igrač je verovatno iscrpljen ili taktički potpuno zatvoren od strane protivnika.");
    $fact.setSeverity("CRITICAL");
    System.out.println(">>> [DROOLS] Okinuto: Pad forme igrača (Domaći)");
end

