rule "6. Ranjivost iz prekida (Korneri) - Domaci"
    salience 70
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId))
    $stats: TeamStatisticGraph(awayCorners > 8)
then
    $fact.setAnalysisText("Protivnik je izveo veliki broj kornera (" + $stats.getAwayCorners() + "), što ukazuje na loše raščišćavanje lopti na bokovima.");
    $fact.setRecommendationText("Markirati striktno ključne skakače protivnika. Krilni igrači moraju bolje da blokiraju centaršuteve.");
    $fact.setSeverity("MEDIUM");
    System.out.println(">>> [DROOLS] Okinuto: Korneri (Domaci)");
end

