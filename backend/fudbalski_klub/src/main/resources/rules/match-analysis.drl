rule "7. Slom veznog reda - Masovno loši pasovi (Domaći)"
    salience 95
when
    $fact: TacticalAnalysisDTO(analysisText == null, $mojId: teamId)
    $game: GameGraph(homeClub != null, homeClub.id != null, homeClub.id.equals($mojId), $expPass: expectedHomePassRate)
    $badPassers: Number(intValue >= 4) from accumulate (
        $a: AppearanceGraph(clubId == $mojId, matchRole == "STARTING_XI", passingAccuracy > 0, passingAccuracy < ($expPass - 12.0)),
        count($a)
    )
then
    $fact.setAnalysisText( $badPassers + " igrača iz postave ima preciznost dodavanja drastično ispod timskog standarda. Struktura tima je razbijena.");
    $fact.setRecommendationText("Uvedite stabilnog centralnog veznog igrača sa klupe. Približite linije tima kako bi dodavanja bila kraća i sigurnija.");
    $fact.setSeverity("HIGH");
    System.out.println(">>> [DROOLS] Okinuto: Masovno loši pasovi (Domaći)");
end

